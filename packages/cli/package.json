{
  "name": "dscheck-cli",
  "version": "0.2.0",
  "description": "The linter that knows your design system \u2014 check, fix, baseline, and report off-system values.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "dscheck": "./dist/cli.js"
  },
  "exports": {
    ".": "./dist/cli.js"
  },
  "files": [
    "LICENSE",
    "README.md",
    "dist"
  ],
  "scripts": {
    "build": "tsdown src/cli.ts src/worker.ts --dts && node ../../scripts/copy-rule-docs.mjs"
  },
  "dependencies": {
    "@typescript-eslint/parser": "^8.67.0",
    "dscheck-core": "workspace:*",
    "dscheck-sarif": "workspace:*",
    "eslint": "^10.9.0",
    "eslint-plugin-dscheck": "workspace:*",
    "picocolors": "^1.1.0",
    "postcss-html": "^2.0.0",
    "postcss-scss": "^4.0.9",
    "stylelint": "^17.14.1",
    "stylelint-dscheck": "workspace:*",
    "tinyglobby": "^0.2.0"
  },
  "devDependencies": {
    "tsdown": "^0.15.0"
  },
  "engines": {
    "node": ">=20.19"
  },
  "keywords": [
    "design-system",
    "design-tokens",
    "linter",
    "tokens",
    "dscheck",
    "cli",
    "lint",
    "tailwindcss",
    "ai-agents",
    "sarif"
  ],
  "author": "Oddur Sigurdsson",
  "homepage": "https://oddurs.github.io/dscheck",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oddurs/dscheck.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/oddurs/dscheck/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
