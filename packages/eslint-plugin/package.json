{
  "name": "eslint-plugin-dscheck",
  "version": "0.1.0",
  "description": "ESLint rules that enforce your design system in JSX, CSS-in-JS, and Tailwind classes.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "LICENSE",
    "README.md",
    "dist"
  ],
  "scripts": {
    "build": "tsdown src/index.ts --dts"
  },
  "dependencies": {
    "dscheck-core": "workspace:*",
    "dscheck-tw": "workspace:*"
  },
  "peerDependencies": {
    "eslint": ">=9"
  },
  "devDependencies": {
    "eslint": "^10.9.0",
    "fast-check": "^4.9.0",
    "tsdown": "^0.15.0"
  },
  "engines": {
    "node": ">=20.19"
  },
  "keywords": [
    "design-system",
    "design-tokens",
    "linter",
    "tokens",
    "dscheck",
    "eslint",
    "eslintplugin",
    "eslint-plugin",
    "tailwindcss",
    "css-in-js"
  ],
  "author": "Oddur Sigurdsson",
  "homepage": "https://oddurs.github.io/dscheck",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oddurs/dscheck.git",
    "directory": "packages/eslint-plugin"
  },
  "bugs": {
    "url": "https://github.com/oddurs/dscheck/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
